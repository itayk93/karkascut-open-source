# OpenAI API Key (הכנס כאן את המפתח שלך או הזן דרך ממשק המשתמש)
OPENAI_API_KEY=

# פורט שרת מקומי
PORT=3050

# מודלים של OpenAI
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_EDITOR_MODEL=gpt-4o-mini

# הגדרות חיתוך שתיקות
SILENCE_THRESHOLD_SECONDS=0.7
SILENCE_PAD_SECONDS=0.25

# מרווח ביטחון (Cut Padding) במילישניות
CUT_PADDING_MS=60

# ספי ביטחון של ה-AI לחיתוך
CONFIDENCE_THRESHOLD_AUTO=0.90
CONFIDENCE_THRESHOLD_SUGGEST=0.70

# Optional local eye-contact runtime (defaults to python3 on PATH)
PYTHON_BIN=python3

# Set false to disable automatic long-cut AI refinement
REFINE_LONG_CUTS=true

# Optional exact frontend origins, comma-separated (never use *).
# Local dev and Capacitor origins are allowed by default.
# Example only: KARKASCUT_ALLOWED_ORIGINS=http://192.168.1.10:3000
KARKASCUT_ALLOWED_ORIGINS=
